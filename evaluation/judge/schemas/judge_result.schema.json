{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EfficientOpt Judge Case Result",
  "type": "object",
  "required": ["problem_id", "model_name", "category", "judge_source"],
  "properties": {
    "dataset_id": {"type": "string"},
    "problem_id": {"type": "string"},
    "model_name": {"type": "string"},
    "category": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "category_label": {"type": "string"},
    "hard_category": {"type": ["integer", "null"], "enum": [null, 5]},
    "judge_source": {"type": "string", "enum": ["llm", "unjudged"]},
    "judge_model": {"type": ["string", "null"]},
    "technique_match": {"type": ["string", "null"]},
    "target_technique_name": {"type": ["string", "null"]},
    "alternative_technique_name": {"type": ["string", "null"]},
    "efficiency_verdict": {"type": "string", "enum": ["good", "poor", "unavailable"]},
    "efficiency_rule_version": {"type": ["string", "null"]},
    "runtime_ratio_to_technique": {"type": ["number", "null"]},
    "runtime_ratio_to_ordinary": {"type": ["number", "null"]},
    "objective_correct_independent": {"type": ["boolean", "null"]},
    "objective_validation_source": {"type": ["string", "null"]},
    "objective_validation_status": {"type": "string", "enum": ["correct", "incorrect", "unknown"]},
    "reference_source": {"type": ["string", "null"]},
    "reference_note": {"type": ["string", "null"]},
    "hard_failure_reason": {"type": ["string", "null"]},
    "failure_reasons": {"type": "array", "items": {"type": "string"}},
    "manual_review": {"type": "boolean"},
    "manual_review_reason": {"type": ["string", "null"]},
    "llm_judgement": {"type": ["object", "null"]},
    "missing_context": {"type": "array", "items": {"type": "string"}}
  }
}
